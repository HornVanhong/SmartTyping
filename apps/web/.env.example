# ==============================================================================
# TypeMaster Web Environment Configuration
# ==============================================================================

# Backend REST API endpoint (Spring Boot running on AWS)
# Local development: http://localhost:8081/api/v1
# AWS Production:   https://api.yourdomain.com/api/v1 (or https://<id>.<region>.awsapprunner.com/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1

# Backend WebSocket STOMP endpoint (Spring Boot running on AWS)
# Local development: ws://localhost:8081/ws
# AWS Production:   wss://api.yourdomain.com/ws (or wss://<id>.<region>.awsapprunner.com/ws)
NEXT_PUBLIC_WS_URL=ws://localhost:8081/ws
